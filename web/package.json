{
  "name": "sisufit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:private": "SISU_PRIVATE=1 vite build --outDir dist-private",
