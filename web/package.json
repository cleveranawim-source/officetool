    "typecheck": "tsc --noEmit",
    "build:gas": "vite build && cp dist/index.html ../apps-script/index.html"
  },
  "dependencies": {
    "preact": "^10.27.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  }
}
